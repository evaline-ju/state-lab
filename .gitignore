# Claude Code local config. Keep this: in a sandboxed setup the launcher copies global
# settings -- which can carry tokens -- into the project's .claude/.
.claude/
# Negation for demos that intentionally ship `.claude/skills/` as content (e.g. config
# bundles under `docs/demos/*/*/bundles/`), not as local Claude Code state.
!docs/demos/**/bundles/**/.claude/
!docs/demos/**/bundles/**/.claude/**

# Secrets and credentials
.env
.env.*
.env.local
*.key
*.pem
*.p12
credentials.*
secrets.*
*kubeconfig*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# --- Add your language's ignores below ---
# Node:   node_modules/ dist/ *.log
# Python: __pycache__/ .venv/ *.egg-info/
# Go:     /bin/ go.work.sum
